# Template biến môi trường cho backend TAPrim.
# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.
#
# Cú pháp "__" là quy ước của .NET để map vào section trong IConfiguration,
# ví dụ ConnectionStrings__MyCnn -> Configuration["ConnectionStrings:MyCnn"].

# --- Cơ sở dữ liệu ---
ConnectionStrings__MyCnn=Server=<host>;Database=<db>;User Id=<user>;Password=<password>;TrustServerCertificate=True;
ConnectionStrings__Redis=redis:6379

# --- Cổng thanh toán VietQR ---
VietQr__ClientId=<client-id>
VietQr__ApiKey=<api-key>

# --- Bot Telegram (thông báo đơn hàng) ---
Telegram__BotToken=<bot-token>
Telegram__SecretToken=<secret-token>
Telegram__WebhookUrl=<https://your-domain/api/TelegramBot/webhook>

# --- Tuỳ chọn triển khai (dùng bởi docker-compose.yaml) ---
APP_IMAGE=tuanballboo/taprim:latest
APP_PORT=80
UPLOADS_HOST_PATH=/var/taprim/images
